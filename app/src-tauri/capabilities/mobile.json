{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Android capabilities",
  "windows": [
    "main"
  ],
  "platforms": [
    "android"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://github.com/**"
        },
        {
          "url": "https://*.githubusercontent.com/**"
        }
      ]
    },
    "clipboard-manager:allow-read-text"
  ]
}
